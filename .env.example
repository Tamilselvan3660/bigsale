# ==============================================================================
# BIGSALE E-Commerce Platform - Environment Configuration Example
# Copy this file to .env in the root or appropriate subdirectories (backend/.env, frontend/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Application Server
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# For Docker: postgresql://bigsale:bigsale_secret@localhost:5432/bigsale?schema=public
# Or inside Docker network: postgresql://bigsale:bigsale_secret@postgres:5432/bigsale?schema=public
DATABASE_URL="postgresql://bigsale:bigsale_secret@localhost:5432/bigsale?schema=public"

# Authentication & Security (JWT)
JWT_SECRET="supersecretjwtkey_bigsale_ecommerce_2026_dev_prod"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Mail / SMTP Server (MailHog default ports: 1025 for SMTP, 8025 for Web UI)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@bigsale.com"

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------

# API Base URL for Client
VITE_API_URL="http://localhost:4000/api"

# Stripe Publishable Key for Client Checkout
VITE_STRIPE_PUBLIC_KEY="pk_test_placeholder"

# Application Metadata
VITE_APP_NAME="BIGSALE E-Commerce"
